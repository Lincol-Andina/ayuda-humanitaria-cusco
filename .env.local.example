# URL del proyecto Supabase (Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave service_role del mismo lugar. NUNCA la expongas al navegador
# (solo la usa el servidor de Next.js en API routes).
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY

# --- Solo para migrar datos desde PocketBase local (npm run db:migrate) ---
POCKETBASE_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@donacion.local
PB_ADMIN_PASSWORD=CambiaEsto123456

# Secreto usado para firmar la cookie de sesión (mínimo 16 caracteres).
SESSION_SECRET=CAMBIA_ESTE_SECRETO_LARGO_DE_AL_MENOS_32_CARACTERES
